# =====================================================================
# .env.example  -  Salin file ini menjadi .env lalu isi nilainya.
# JANGAN commit file .env ke repositori.
# =====================================================================

# --- Kredensial Akun MT5 (wajib) ---
ACCOUNT=12345678
PASSWORD=your_mt5_password_here
SERVER=YourBroker-Demo
SYMBOL=XAUUSD.vx

# --- Parameter trading ---
LOT_SIZE=0.01
# MAX_SPREAD: batas spread dalam poin (kira-kira 2x median spread pantauan).
# Untuk XAUUSD.vx Valetax, mulai dengan 60. Kosongkan = tanpa filter.
MAX_SPREAD=60
MAX_CONSECUTIVE_LOSS=3
# TRAILING_MODE: satu-satunya nilai yang diimplementasikan adalah 'step'
TRAILING_MODE=step
MT5_PATH=

# --- Mode eksekusi ---
# signal_only : hanya tampilkan sinyal, TIDAK mengirim order (DEFAULT AMAN)
# demo_orders : kirim order ke akun demo MT5
MODE=signal_only
# ALLOW_REAL : izin eksplisit untuk akun REAL. JANGAN ubah ke true kecuali Anda sadar risikonya.
ALLOW_REAL=false

# --- Parameter strategi (default kandidat ATR4/ADX30 — BELUM terbukti unggul) ---
# Lihat docs/results/uji_bersih.md untuk detail hasil uji bersih.
ATR_MULT=4.0
ADX_MIN=30.0
EMA_FAST=20
EMA_SLOW=50
RSI_PERIOD=10

# --- Batas risiko opsional (default mati = kosong) ---
# MAX_DAILY_LOSS_PERCENT=5.0
# MAX_DRAWDOWN_PERCENT=20.0

# --- Filter jam entry opsional (jam server broker, bukan WIB) ---
# Data menunjukkan filter jam tidak membantu; default mati.
# HOUR_START=9
# HOUR_END=18

# --- Notifikasi Gmail (Opsional, Tahap 5) ---
# GMAIL_USER=your_email@gmail.com
# GMAIL_APP_PASSWORD=your_gmail_app_password
# ALERT_TO=recipient_email@gmail.com

# --- Integrasi AI / 9router (Opsional, Tahap 5 — hanya informasi berita) ---
# AI_BASE_URL=http://localhost:20128/v1
# AI_API_KEY=your_api_key_here
# AI_MODEL=prioritas
